{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?:.*\\.)?hellyoshaqiqie\\.my\\.id"
        }
      ],
      "destination": "https://www.hellyoshaqiqie.id/:path*",
      "permanent": true
    },
    {
      "source": "/projects/fleetmanagement",
      "destination": "/project/fleet-management",
      "permanent": true
    },
    {
      "source": "/projects/DermDoc",
      "destination": "/project/dermdoc",
      "permanent": true
    },
    {
      "source": "/projects/dermdoc",
      "destination": "/project/dermdoc",
      "permanent": true
    },
    {
      "source": "/projects/IoT-smart-home",
      "destination": "/project/smart-home",
      "permanent": true
    },
    {
      "source": "/projects/iot-smart-home",
      "destination": "/project/smart-home",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*\\.(?:js|css|svg|webp|mp4|webm))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(?:webp|png|ico|svg))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap.xsl",
      "headers": [
        { "key": "Content-Type", "value": "application/xslt+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
